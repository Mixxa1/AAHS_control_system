#include <iostream>

enum State
{
    READY,
    DISPENSING,
    WAIT_HAND_REMOVE,
    BLOCKED
};

State currentState = READY;

int g_handState = 0;      // 0 - рука не обнаружена, 1 - рука обнаружена
int g_batteryState = 1;   // 0 - питания нет, 1 - питание в норме
int g_liquidState = 1;    // 0 - жидкости нет, 1 - жидкость есть


// Имитация выходных сигналов
int g_pumpState = 0;            // 0 - выключен, 1 - включен
int g_readyIndicatorState = 0;  // 0 - выключен, 1 - включен
int g_blockIndicatorState = 0;  // 0 - выключен, 1 - включен


// Имитация процесса отсчета времени распыления
const int SPRAY_TIME_MS = 400;

int g_timeProcessActive = 0;     // 0 - таймер не активен, 1 - таймер активен
int g_timeProcessDone = 0;       // 0 - время не завершилось, 1 - завершилось
int g_timeRemainingMs = 0;       // сколько миллисекунд осталось

int GetHandState()
{
    return g_handState;
}

int GetBatteryState()
{
    return g_batteryState;
}

int GetLiquidState()
{
    return g_liquidState;
}

int GetTimeProcess()
{
    // 0 - требуемое время распыления не завершилось
    // 1 - требуемое время распыления завершилось
    return g_timeProcessDone;
}

// Выходные функции
void PumpControl(int state)
{
    g_pumpState = state;
}

void ReadyIndicatorControl(int state)
{
    g_readyIndicatorState = state;
}

void BlockIndicatorControl(int state)
{
    g_blockIndicatorState = state;
}

void TimeProcessControl(int state)
{
    // 0 - остановить / сбросить отсчёт
    // 1 - начать отсчёт времени распыления
    if (state == 1)
    {
        g_timeProcessActive = 1;
        g_timeProcessDone = 0;
        g_timeRemainingMs = SPRAY_TIME_MS;
    }
    else
    {
        g_timeProcessActive = 0;
        g_timeProcessDone = 0;
        g_timeRemainingMs = 0;
    }
}

void TimerTick(int deltaTimeMs)
{
    if (g_timeProcessActive == 1)
    {
        g_timeRemainingMs = g_timeRemainingMs - deltaTimeMs;

        if (g_timeRemainingMs <= 0)
        {
            g_timeRemainingMs = 0;
            g_timeProcessActive = 0;
            g_timeProcessDone = 1;
        }
    }
}


void ApplyOutputs()
{
    if (currentState == READY)
    {
        PumpControl(0);
        ReadyIndicatorControl(1);
        BlockIndicatorControl(0);
    }
    else if (currentState == DISPENSING)
    {
        PumpControl(1);
        ReadyIndicatorControl(0);
        BlockIndicatorControl(0);
    }
    else if (currentState == WAIT_HAND_REMOVE)
    {
        PumpControl(0);
        ReadyIndicatorControl(0);
        BlockIndicatorControl(0);
    }
    else if (currentState == BLOCKED)
    {
        PumpControl(0);
        ReadyIndicatorControl(0);
        BlockIndicatorControl(1);
    }
}

void UpdateSystem()
{
    int hand = GetHandState();
    int battery = GetBatteryState();
    int liquid = GetLiquidState();
    int timeDone = GetTimeProcess();

    //Проверка блокирующих условий
    if (battery == 0 || liquid == 0)
    {
        currentState = BLOCKED;
        TimeProcessControl(0);
        ApplyOutputs();
        return;
    }

    //Выход из блокировки при восстановлении ресурсов
    //
    if (currentState == BLOCKED && battery == 1 && liquid == 1)
    {
        currentState = READY;
    }

   // Логика состояний
    if (currentState == READY)
    {
        if (hand == 1)
        {
            currentState = DISPENSING;
            TimeProcessControl(1); // запуск отсчёта времени распыления
        }
    }
    else if (currentState == DISPENSING)
    {
        if (timeDone == 1)
        {
            PumpControl(0);
            currentState = WAIT_HAND_REMOVE;
            g_timeProcessDone = 0; // сброс сигнала завершения после обработки
        }
    }
    else if (currentState == WAIT_HAND_REMOVE)
    {
        if (hand == 0)
        {
            currentState = READY;
        }
    }

    ApplyOutputs();
}

void PrintSystemState()
{
    std::cout << "State: ";

    if (currentState == READY)
    {
        std::cout << "READY";
    }
    else if (currentState == DISPENSING)
    {
        std::cout << "DISPENSING";
    }
    else if (currentState == WAIT_HAND_REMOVE)
    {
        std::cout << "WAIT_HAND_REMOVE";
    }
    else if (currentState == BLOCKED)
    {
        std::cout << "BLOCKED";
    }

    std::cout
        << " | Pump=" << g_pumpState
        << " | ReadyIndicator=" << g_readyIndicatorState
        << " | BlockIndicator=" << g_blockIndicatorState
        << " | TimeDone=" << g_timeProcessDone
        << "\n";
}

int main()
{
    std::cout << "Initial state:\n";
    UpdateSystem();
    PrintSystemState();

    std::cout << "\n1) Рука обнаружена:\n";
    g_handState = 1;
    UpdateSystem();
    PrintSystemState();

    std::cout << "\n2) Прошло 200 мс:\n";
    TimerTick(200);
    UpdateSystem();
    PrintSystemState();

    std::cout << "\n3) Прошло еще 250 мс:\n";
    TimerTick(250);
    UpdateSystem();
    PrintSystemState();

    std::cout << "\n4) Рука все еще в зоне:\n";
    UpdateSystem();
    PrintSystemState();

    std::cout << "\n5) Руку убрали:\n";
    g_handState = 0;
    UpdateSystem();
    PrintSystemState();

    std::cout << "\n6) Жидкость закончилась:\n";
    g_liquidState = 0;
    UpdateSystem();
    PrintSystemState();

    std::cout << "\n7) Жидкость восстановлена:\n";
    g_liquidState = 1;
    UpdateSystem();
    PrintSystemState();

    std::cout << "\n8) Питание пропало:\n";
    g_batteryState = 0;
    UpdateSystem();
    PrintSystemState();

    std::cout << "\n9) Питание восстановлено:\n";
    g_batteryState = 1;
    UpdateSystem();
    PrintSystemState();

    return 0;
}
